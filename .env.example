# ---- Backend selection ----
LLM_PROVIDER=ollama
EMBEDDING_PROVIDER=ollama
VECTOR_STORE=faiss
DOCUMENT_STORAGE=local

# ---- Phase 1: local Ollama ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=qwen3:8b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---- Phase 2: Azure OpenAI ----
# Auth uses DefaultAzureCredential (`az login` locally, managed identity in Azure); no API key.
# Set LLM_PROVIDER=azure and/or EMBEDDING_PROVIDER=azure above to use these.
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com/
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_REASONING_EFFORT=low  # "minimal" occasionally refused answerable questions

# ---- Phase 3: Azure AI Search ----
# Set VECTOR_STORE=azure_search above to use it. Index defaults to pdf-chunks-<EMBEDDING_PROVIDER>.
AZURE_SEARCH_ENDPOINT=https://<your-service>.search.windows.net

# ---- Phase 4: Azure Blob Storage ----
# Set DOCUMENT_STORAGE=blob above to store uploaded PDFs in Blob instead of data/raw/.
AZURE_STORAGE_ACCOUNT_URL=https://<your-account>.blob.core.windows.net/
AZURE_STORAGE_CONTAINER=documents

# ---- Chunking / retrieval ----
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
TOP_K=5
TEMPERATURE=0.1
